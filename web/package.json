{
  "name": "tickraft-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm --filter tickraft-web-app dev",
    "build": "pnpm --filter tickraft-web-app build",
    "preview": "pnpm --filter tickraft-web-app preview",
    "lint": "eslint \"packages/**/*.{vue,js,jsx,ts,tsx}\" \"app/src/**/*.{vue,js,jsx,ts,tsx}\"",
    "format": "prettier --write packages/ app/",
    "stylelint": "stylelint \"packages/**/*.{css,scss,vue}\" \"app/**/*.{css,scss,vue}\" --fix",
    "type-check": "vue-tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.1.0",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "mockjs": "^1.1.0",
    "prettier": "^3.9.6",
    "postcss-html": "^2.0.0",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.7.5",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.9",
    "@vue/test-utils": "^2.4.11"
  }
}
