# Binaries
bin/
*.exe

# Frontend
web/node_modules/
web/**/node_modules/
web/app/dist/
web/packages/*/dist/
web/**/*.tsbuildinfo
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Config
config.yaml
*.local

# Go
vendor/

reports/*

# Embedded frontend (generated by build). Use /* so git still descends into
# the directory and the negation for .gitkeep below takes effect; a trailing
# slash would exclude the directory itself and skip the negation.
internal/web/dist/*
!internal/web/dist/.gitkeep
web/app/.vite
